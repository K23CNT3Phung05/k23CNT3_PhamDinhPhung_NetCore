@model Category

@{
    ViewData["Title"] = "Chi tiết thể loại";
}

<h1>Chi tiết thể loại</h1>

<hr />
<dl class="row">
    <dt class="col-sm-2">Tên thể loại</dt>
    <dd class="col-sm-10">@Model.CategoryName</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary">Sửa</a>
<a asp-action="PdpIndex" class="btn btn-secondary">Quay lại</a>
