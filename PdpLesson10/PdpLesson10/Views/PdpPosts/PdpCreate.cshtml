@model PdpLesson10.Models.PdpPosts

@{
    ViewData["Title"] = "Thêm mới bài viết";
}


<form asp-action="PdpCreate" enctype="multipart/form-data">
<div class="card shadow-sm mx-auto" style="max-width: 600px;">

    <div class="card-header">
        <h2 class="text-center my-4">@ViewData["Title"]</h2>
    </div>
    <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="PdpTitle" class="form-label fw-semibold"></label>
                <input asp-for="PdpTitle" class="form-control" placeholder="Nhập tiêu đề bài viết" />
                <span asp-validation-for="PdpTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PdpImage" class="form-label fw-semibold"></label>
                <input asp-for="PdpImage" class="form-control" type="file" />
                <span asp-validation-for="PdpImage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PdpContent" class="form-label fw-semibold"></label>
                <textarea asp-for="PdpContent" class="form-control" rows="4" placeholder="Nhập nội dung bài viết"></textarea>
                <span asp-validation-for="PdpContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PdpStatus" class="form-label fw-semibold"></label>
                <select asp-for="PdpStatus" class="form-select">
                    <option value="">--Chọn trạng thái--</option>
                    <option value="true">Hiển thị</option>
                    <option value="false">Ẩn</option>
                </select>
                <span asp-validation-for="PdpStatus" class="text-danger"></span>
            </div>

           
        
    </div>
    <div class="card-footer">
         <button type="submit" class="btn btn-primary mr-2">Ghi lại</button>
         <a asp-action="PdpIndex" class="btn btn-secondary">Quay lại danh sách</a>

    </div>
</div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}