@model IEnumerable<PdpLesson10.Models.PdpPosts>

@{
    ViewData["Title"] = "Quản lý bài viết";
}




<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>@ViewData["Title"]</h1>
        <a asp-action="PdpCreate" class="btn btn-primary">Thêm mới</a>
</div>

<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PdpId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdpTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdpImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdpContent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdpStatus)
            </th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PdpId)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdpTitle)
                </td>
            <td>
                <img src="@item.PdpImage" style="width:50px"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdpContent)
            </td>
                <td class="d-flex justify-content-between align-items-center">
                    @if (item.PdpStatus==true){
                        <span class="badge bg-success">Hiển thị</span>
                    }else{
                        <span class="badge bg-danger">Tạm ẩn</span>
                    }
            </td>
            <td>
                    <a asp-action="PdpEdit" asp-route-PdpId="@item.PdpId" class="btn btn-success">Edit</a> 
                    <a asp-action="PdpDetails" asp-route-PdpId="@item.PdpId" class="btn btn-info">Details</a>
                    <a asp-action="PdpDelete" asp-route-PdpId="@item.PdpId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>