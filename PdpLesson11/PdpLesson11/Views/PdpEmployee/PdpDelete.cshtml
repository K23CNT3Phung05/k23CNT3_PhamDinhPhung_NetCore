@model PhamDinhPhung_2310900083.Models.PdpEmployee

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h4 class="text-center">Bạn có chắc muốn xóa nhân viên này?</h4>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Model.PdpEmpName</dd>

            <dt class="col-sm-4">Cấp bậc</dt>
            <dd class="col-sm-8">@Model.PdpEmpLevel</dd>

            <dt class="col-sm-4">Ngày bắt đầu</dt>
            <dd class="col-sm-8">@Model.PdpEmpStartDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                @(Model.PdpEmpStatus == true ? "Hiển thị" : "Tạm ẩn")
            </dd>
        </dl>
    </div>

    <div class="card-footer text-center">
        <form asp-action="PdpDelete">
            <input type="hidden" asp-for="PdpEmpId" />
            <button type="submit" class="btn btn-danger me-2">🗑️ Xác nhận xóa</button>
            <a asp-action="PdpIndex" class="btn btn-secondary">⬅️ Quay lại</a>
        </form>
    </div>
</div>
